# =================================================================
# TECHHACKS-GROWTH: CONFIGURAZIONE API LIVE PER LE 4 PIATTAFORME VIDEO
# (YouTube Shorts, Instagram Reels, Facebook Reels, TikTok Videos)
# =================================================================

# -----------------------------------------------------------------
# 1. TELEGRAM BOT (per il Report Giornaliero delle Visualizzazioni)
# -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=870620791

# -----------------------------------------------------------------
# 2. GOOGLE GEMINI API (per il Growth Radar & Strategie Virali)
# -----------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------
# 3. YOUTUBE DATA API v3 (per Views LIVE su YouTube Shorts @techhacks_aii)
# Ottienila gratis su https://console.cloud.google.com/ -> YouTube Data API v3
# -----------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=UCAd_VYwyU2TP_SOn33SzXHw
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@techhacks_aii

# -----------------------------------------------------------------
# 4. INSTAGRAM GRAPH API (per Views LIVE su Instagram Reels @techs_ai1)
# Ottienila su https://developers.facebook.com/ -> Instagram Graph API
# -----------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here
INSTAGRAM_PROFILE_URL=https://www.instagram.com/techs_ai1/

# -----------------------------------------------------------------
# 5. FACEBOOK PAGE GRAPH API (per Views LIVE su Facebook Reels)
# Ottienila su https://developers.facebook.com/ -> Facebook Graph API
# -----------------------------------------------------------------
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_URL=https://www.facebook.com/techhacks.ai

# -----------------------------------------------------------------
# 6. TIKTOK DISPLAY API (per Views LIVE su TikTok Videos @techhacks.ai)
# Ottienila su https://developers.tiktok.com/ -> TikTok Display API
# -----------------------------------------------------------------
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
TIKTOK_OPEN_ID=your_tiktok_open_id_here
TIKTOK_PROFILE_URL=https://www.tiktok.com/@techhacks.ai

# -----------------------------------------------------------------
# VALORI REALI TEMPORANEI (se i token non sono ancora inseriti)
# -----------------------------------------------------------------
YOUTUBE_TOTAL_VIEWS=25
YOUTUBE_SUBSCRIBERS=1

INSTAGRAM_TOTAL_VIEWS=120
INSTAGRAM_FOLLOWERS=10

FACEBOOK_TOTAL_VIEWS=0
